+
+        // Trim the end of the line off if cols shrunk. This must run for EVERY buffer, not
+        // only the reflowing one. `isReflowEnabled` is just `hasScrollback` (Buffer.swift:419)
+        // and the alt buffer is constructed with `scrollback: nil` (Terminal.swift:694), so
+        // while this loop sat inside the `isReflowEnabled` branch the alt buffer's BufferLines
+        // kept their OLD width forever while `cols` shrank underneath them. A later widening
+        // then calls BufferLine.resize with a count SMALLER than dataSize, whose shrink branch
+        // preserves data[0..<cols] verbatim (BufferLine.swift:197) — resurrecting cells from
+        // before the narrowing back into the visible grid. Under tmux, which lives in the alt
+        // buffer and repaints only the deltas it believes changed, that is stale text
+        // appearing inside the wrong pane and surviving a window switch.
+        // Must stay AFTER reflow: reflow rewraps from the OLD width.
+        if cols > newCols {
+            // lines.count, not lines.maxLength (see the widen loop above).
+            for i in 0..<lines.count {
+                lines [i].resize (cols: newCols, fillData: CharData.Null)
             }
         }
         
